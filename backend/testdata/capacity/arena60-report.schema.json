{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-per-minute.local/schemas/arena60-report.schema.json",
  "title": "Arena capacity report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "identity",
    "workload",
    "window",
    "load",
    "operations",
    "latency_ms",
    "throughput",
    "lag",
    "reconnect",
    "resources",
    "database",
    "thresholds",
    "digests",
    "environment_equivalence"
  ],
  "properties": {
    "schema": {
      "const": "arena-capacity-report"
    },
    "version": {
      "const": "1.0.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "build"],
      "properties": {
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "dirty"],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "dirty": {
              "type": "boolean"
            }
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["go_version", "target", "digest"],
          "properties": {
            "go_version": {
              "type": "string",
              "pattern": "^go[0-9]+\\.[0-9]+(\\.[0-9]+)?([a-z0-9.-]+)?$"
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z0-9]+/[a-z0-9]+$"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "profile", "operation"],
      "properties": {
        "name": {
          "enum": ["arena60", "arena45"]
        },
        "profile": {
          "enum": ["nominal", "peak"]
        },
        "operation": {
          "const": "arena_game_repository_get"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "duration_seconds"],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participants", "games", "workers", "operation_interval_ms"],
      "properties": {
        "participants": {
          "type": "integer",
          "minimum": 2
        },
        "games": {
          "type": "integer",
          "minimum": 1
        },
        "workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "operation_interval_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "succeeded", "failed", "correctness"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "correctness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checks", "passed", "failed", "status"],
          "properties": {
            "checks": {
              "type": "integer",
              "minimum": 1
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "$ref": "#/$defs/status"
            }
          }
        }
      }
    },
    "latency_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50", "p95", "p99", "max", "p99_limit", "status"],
      "properties": {
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "p99": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "p99_limit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "throughput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations_per_second", "minimum", "status"],
      "properties": {
        "operations_per_second": {
          "type": "number",
          "minimum": 0
        },
        "minimum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "lag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "p95_ms", "max_ms", "max_limit_ms", "status"],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_limit_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "reconnect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "succeeded", "failed", "status"],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
      "succeeded": {
        "type": "integer",
        "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "goroutines", "heap_alloc_bytes"],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "goroutines": {
          "$ref": "#/$defs/boundedInteger"
        },
        "heap_alloc_bytes": {
          "$ref": "#/$defs/boundedInteger"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool_limit", "observed_max", "acquired_end", "idle_end", "total_end", "status"],
      "properties": {
        "pool_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "observed_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "acquired_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "idle_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "total_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "thresholds": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "comparator", "limit", "observed", "unit", "status"],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_]+$"
          },
          "comparator": {
            "enum": ["<=", ">="]
          },
          "limit": {
            "type": "number",
            "minimum": 0
          },
          "observed": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "enum": ["count", "milliseconds", "operations_per_second", "bytes"]
          },
          "status": {
            "$ref": "#/$defs/status"
          }
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "images"],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "digest"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference", "digest", "digest_scope"],
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "$ref": "#/$defs/digest"
              },
              "digest_scope": {
                "const": "content"
              }
            }
          }
        }
      }
    },
    "environment_equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "production_repository",
        "database_engine",
        "database_major",
        "migration_engine",
        "container_image",
        "differences"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "scope": {
          "const": "repository-and-database-major"
        },
        "production_repository": {
          "const": true
        },
        "database_engine": {
          "const": "postgresql"
        },
        "database_major": {
          "const": 18
        },
        "migration_engine": {
          "const": "goose"
        },
        "container_image": {
          "const": "postgres:18-alpine"
        },
        "differences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["PASS", "FAIL"]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundedInteger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "observed_max", "status"],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "observed_max": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workload": {
            "properties": {
              "profile": {
                "const": "nominal"
              }
            },
            "required": ["profile"]
          }
        },
        "required": ["workload"]
      },
      "then": {
        "properties": {
          "workload": {
            "properties": {
              "name": {
                "const": "arena60"
              }
            }
          },
          "window": {
            "properties": {
              "duration_seconds": {
                "minimum": 3600
              }
            }
          },
          "load": {
            "properties": {
              "participants": {
                "const": 16
              },
              "games": {
                "const": 8
              },
              "workers": {
                "const": 4
              },
              "operation_interval_ms": {
                "const": 250
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload": {
            "properties": {
              "profile": {
                "const": "peak"
              }
            },
            "required": ["profile"]
          }
        },
        "required": ["workload"]
      },
      "then": {
        "properties": {
          "workload": {
            "properties": {
              "name": {
                "const": "arena45"
              }
            }
          },
          "window": {
            "properties": {
              "duration_seconds": {
                "minimum": 2700
              }
            }
          },
          "load": {
            "properties": {
              "participants": {
                "const": 16
              },
              "games": {
                "const": 8
              },
              "workers": {
                "const": 8
              },
              "operation_interval_ms": {
                "const": 100
              }
            }
          }
        }
      }
    }
  ]
}
