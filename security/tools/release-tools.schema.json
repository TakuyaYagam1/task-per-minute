{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-per-minute.local/schemas/release-tools.schema.json",
  "title": "Task Per Minute release security toolchain lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "reviewed_at",
    "platform",
    "tools",
    "playwright_chromium",
    "validation_images",
    "trivy_database"
  ],
  "properties": {
    "schema": {
      "const": "security/tools/release-tools.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "reviewed_at": {
      "$ref": "#/$defs/date"
    },
    "platform": {
      "$ref": "#/$defs/platform"
    },
    "tools": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "playwright_chromium": {
      "$ref": "#/$defs/playwrightChromium"
    },
    "validation_images": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/validationImage"
      }
    },
    "trivy_database": {
      "$ref": "#/$defs/trivyDatabase"
    }
  },
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": {"const": "linux"},
        "arch": {"const": "amd64"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source",
        "runtime_identity",
        "provisioning",
        "trust_decision"
      ],
      "properties": {
        "name": {
          "enum": [
            "go",
            "node",
            "npm",
            "playwright",
            "chromium",
            "jq",
            "yq",
            "docker",
            "docker-compose",
            "govulncheck",
            "gitleaks",
            "semgrep",
            "trivy"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+){1,3}$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "runtime_identity": {
          "$ref": "#/$defs/runtimeIdentity"
        },
        "provisioning": {
          "$ref": "#/$defs/provisioning"
        },
        "trust_decision": {
          "$ref": "#/$defs/trustDecision"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "release_url", "license"],
      "properties": {
        "repository_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "release_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "license": {
          "$ref": "#/$defs/licenseReview"
        }
      }
    },
    "licenseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "reviewed_at", "status", "evidence_url"],
      "properties": {
        "spdx": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+$"
        },
        "reviewed_at": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "enum": ["accepted", "unresolved"]
        },
        "evidence_url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arguments", "expected_output", "timeout_seconds"],
      "properties": {
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_output": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        }
      }
    },
    "provisioning": {
      "oneOf": [
        {"$ref": "#/$defs/systemProvisioning"},
        {"$ref": "#/$defs/archiveProvisioning"},
        {"$ref": "#/$defs/testProvisioning"},
        {"$ref": "#/$defs/unresolvedProvisioning"}
      ]
    },
    "systemProvisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command"],
      "properties": {
        "kind": {"const": "system"},
        "command": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
      }
    },
    "archiveProvisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "immutable_root",
        "relative_path",
        "executable_sha256",
        "archive_file",
        "archive_sha256",
        "archive_format",
        "extraction_member"
      ],
      "properties": {
        "kind": {"const": "archive"},
        "immutable_root": {"$ref": "#/$defs/absolutePath"},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "archive_file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.tar\\.gz$"
        },
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "archive_format": {"const": "tar.gz"},
        "extraction_member": {"$ref": "#/$defs/relativePath"}
      }
    },
    "testProvisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "immutable_root", "relative_path", "executable_sha256"],
      "properties": {
        "kind": {"const": "test_root"},
        "immutable_root": {"$ref": "#/$defs/absolutePath"},
        "relative_path": {"$ref": "#/$defs/relativePath"},
        "executable_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "unresolvedProvisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"const": "unresolved"},
        "reason": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "trustDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {
          "enum": ["accepted", "unresolved"]
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "playwrightChromium": {
      "oneOf": [
        {"$ref": "#/$defs/acceptedPlaywrightChromium"},
        {"$ref": "#/$defs/unresolvedPlaywrightChromium"}
      ]
    },
    "acceptedPlaywrightChromium": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "package_lock_relative_path",
        "package_lock_sha256",
        "playwright_package_version",
        "browsers_json_relative_path",
        "browsers_json_sha256",
        "chromium_revision",
        "chromium_browser_version",
        "chromium_executable_sha256"
      ],
      "properties": {
        "status": {"const": "accepted"},
        "package_lock_relative_path": {"$ref": "#/$defs/relativePath"},
        "package_lock_sha256": {"$ref": "#/$defs/sha256"},
        "playwright_package_version": {"$ref": "#/$defs/semver"},
        "browsers_json_relative_path": {"$ref": "#/$defs/relativePath"},
        "browsers_json_sha256": {"$ref": "#/$defs/sha256"},
        "chromium_revision": {"type": "string", "pattern": "^[0-9]+$"},
        "chromium_browser_version": {"$ref": "#/$defs/browserVersion"},
        "chromium_executable_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "unresolvedPlaywrightChromium": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "package_lock_relative_path",
        "package_lock_sha256",
        "playwright_package_version",
        "browsers_json_relative_path",
        "browsers_json_sha256",
        "chromium_revision",
        "chromium_browser_version",
        "observed_browser_version",
        "chromium_executable_sha256",
        "reason"
      ],
      "properties": {
        "status": {"const": "unresolved"},
        "package_lock_relative_path": {"$ref": "#/$defs/relativePath"},
        "package_lock_sha256": {"$ref": "#/$defs/sha256"},
        "playwright_package_version": {"$ref": "#/$defs/semver"},
        "browsers_json_relative_path": {"$ref": "#/$defs/relativePath"},
        "browsers_json_sha256": {"$ref": "#/$defs/sha256"},
        "chromium_revision": {"type": "string", "pattern": "^[0-9]+$"},
        "chromium_browser_version": {"$ref": "#/$defs/browserVersion"},
        "observed_browser_version": {"$ref": "#/$defs/browserVersion"},
        "chromium_executable_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {"type": "string", "minLength": 20}
      }
    },
    "validationImage": {
      "oneOf": [
        {"$ref": "#/$defs/acceptedImage"},
        {"$ref": "#/$defs/unresolvedImage"}
      ]
    },
    "acceptedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "name",
        "requested_tag",
        "reference",
        "platform",
        "config_digest",
        "source",
        "license"
      ],
      "properties": {
        "status": {"const": "accepted"},
        "name": {"enum": ["caddy", "postgres", "redis", "seaweedfs"]},
        "requested_tag": {"type": "string", "minLength": 3},
        "reference": {"$ref": "#/$defs/imageDigestReference"},
        "platform": {"const": "linux/amd64"},
        "config_digest": {"$ref": "#/$defs/imageDigest"},
        "source": {"$ref": "#/$defs/httpsUrl"},
        "license": {"$ref": "#/$defs/licenseReview"}
      }
    },
    "unresolvedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "name", "requested_tag", "source", "reason"],
      "properties": {
        "status": {"const": "unresolved"},
        "name": {"enum": ["caddy", "postgres", "redis", "seaweedfs"]},
        "requested_tag": {"type": "string", "minLength": 3},
        "source": {"$ref": "#/$defs/httpsUrl"},
        "reason": {"type": "string", "minLength": 20}
      }
    },
    "trivyDatabase": {
      "oneOf": [
        {"$ref": "#/$defs/acceptedTrivyDatabase"},
        {"$ref": "#/$defs/unresolvedTrivyDatabase"}
      ]
    },
    "acceptedTrivyDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "immutable_root",
        "metadata_relative_path",
        "database_relative_path",
        "metadata_sha256",
        "database_sha256",
        "updated_at",
        "max_age_hours"
      ],
      "properties": {
        "status": {"const": "accepted"},
        "source": {"$ref": "#/$defs/httpsUrl"},
        "immutable_root": {"$ref": "#/$defs/absolutePath"},
        "metadata_relative_path": {"$ref": "#/$defs/relativePath"},
        "database_relative_path": {"$ref": "#/$defs/relativePath"},
        "metadata_sha256": {"$ref": "#/$defs/sha256"},
        "database_sha256": {"$ref": "#/$defs/sha256"},
        "updated_at": {"$ref": "#/$defs/dateTime"},
        "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 336}
      }
    },
    "unresolvedTrivyDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "updated_at_date", "max_age_hours", "reason"],
      "properties": {
        "status": {"const": "unresolved"},
        "source": {"$ref": "#/$defs/httpsUrl"},
        "updated_at_date": {"$ref": "#/$defs/date"},
        "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 336},
        "reason": {"type": "string", "minLength": 20}
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "imageDigestReference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://\\S+$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/\\S+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/+@-]+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "browserVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
