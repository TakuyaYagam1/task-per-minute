{
  "name": "task-per-minute",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0 --ignore-pattern .next --ignore-pattern node_modules --ignore-pattern lib/shared/api/schema.ts && npm run lint:architecture",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0 --ignore-pattern .next --ignore-pattern node_modules --ignore-pattern lib/shared/api/schema.ts --fix",
    "lint:architecture": "node scripts/check-fsd.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "openapi:generate": "bash ../backend/scripts/openapi-generate.sh",
    "codegen": "npm run openapi:generate",
    "gen:types": "npm run openapi:generate",
    "audit:dependencies": "bash ../scripts/release/run-npm-audit.sh && bash ../scripts/release/run-npm-build-tool-audit.sh",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:live": "E2E_LIVE=1 node scripts/run-e2e.mjs e2e/live-backend.spec.ts",
    "test:e2e:full-stack": "bash ../scripts/release/verify-security-tools.sh --scope frontend && ../scripts/e2e-local-compose.sh",
    "validate:frontend": "node scripts/validate-frontend-baseline.mjs",
    "verify:ci": "node scripts/verify-frontend-ci.mjs",
    "check": "npm run validate:frontend && npm run openapi:generate && npm run typecheck && npm run lint && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "^15.5.25",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.1.0",
    "styled-jsx": "^5.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@redocly/cli": "2.51.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.5.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.15",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "yaml": "2.9.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "js-yaml": "4.3.2",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.13"
    }
  }
}
